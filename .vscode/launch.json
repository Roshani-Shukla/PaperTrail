{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start PaperTrail Backend (Node.js)",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend",
            "restart": true
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch PaperTrail in Chrome",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ]
}
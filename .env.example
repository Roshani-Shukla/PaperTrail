# ====================================================================
# PaperTrail Environment Configuration Template
# Copy this file to .env (or backend/.env) and replace placeholders
# with your actual database credentials.
# ====================================================================

# Backend Server Configuration
PORT=5000

# Aiven MySQL Database Connection Details
DB_HOST=mysql-7d97186-rushukla003-a042.k.aivencloud.com
DB_PORT=19710
DB_USER=avnadmin
DB_PASSWORD=your_aiven_mysql_password
DB_NAME=research_repository

# Database SSL Options (Required for Aiven)
# DB_SSL: Set to 'true' for Aiven/cloud MySQL, 'false' for local MySQL without SSL
DB_SSL=true

# DB_SSL_CA_PATH: Path to the CA certificate (defaults to ./ca.pem or ./backend/ca.pem)
DB_SSL_CA_PATH=./backend/ca.pem

# DB_SSL_CA: Alternatively, paste the raw CA certificate content directly here (convenient for Vercel/Render)
# DB_SSL_CA=

# CORS Configuration: Comma-separated list of allowed origins (* for all)
FRONTEND_URL=*
